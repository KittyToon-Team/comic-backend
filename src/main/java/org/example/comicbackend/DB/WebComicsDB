-- 1. Tạo Database
CREATE DATABASE WebComicsDB;
GO

-- Sử dụng Database vừa tạo
USE WebComicsDB;
GO

-- 2. Tạo bảng Người dùng (Users)
CREATE TABLE Users (
    id INT IDENTITY(1,1) PRIMARY KEY,
    username VARCHAR(50) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL,
    email VARCHAR(100) NOT NULL UNIQUE,
    avatar_url VARCHAR(255),
    role VARCHAR(20) DEFAULT 'USER', -- 'USER' hoặc 'ADMIN'
    created_at DATETIME DEFAULT GETDATE()
);
GO

-- 3. Tạo bảng Thể loại (Categories)
CREATE TABLE Categories (
    id INT IDENTITY(1,1) PRIMARY KEY,
    name NVARCHAR(100) NOT NULL UNIQUE,
    description NVARCHAR(500)
);
GO

-- 4. Tạo bảng Truyện (Stories)
CREATE TABLE Stories (
    id INT IDENTITY(1,1) PRIMARY KEY,
    title NVARCHAR(255) NOT NULL,
    author NVARCHAR(150),
    description NVARCHAR(MAX),
    cover_image_url VARCHAR(255),
    status NVARCHAR(50) DEFAULT N'Đang ra', -- Đang ra, Hoàn thành, Tạm ngưng
    view_count INT DEFAULT 0,
    created_at DATETIME DEFAULT GETDATE(),
    updated_at DATETIME DEFAULT GETDATE()
);
GO

-- 5. Tạo bảng trung gian Truyện - Thể loại (Nhiều - Nhiều)
CREATE TABLE Story_Category (
    story_id INT,
    category_id INT,
    PRIMARY KEY (story_id, category_id),
    FOREIGN KEY (story_id) REFERENCES Stories(id) ON DELETE CASCADE,
    FOREIGN KEY (category_id) REFERENCES Categories(id) ON DELETE CASCADE
);
GO

-- 6. Tạo bảng Chương truyện (Chapters)
CREATE TABLE Chapters (
    id INT IDENTITY(1,1) PRIMARY KEY,
    story_id INT NOT NULL,
    chapter_number FLOAT NOT NULL, -- Dùng FLOAT để hỗ trợ chương 1.5, 1.2
    title NVARCHAR(255),
    content NVARCHAR(MAX), -- Lưu nội dung text (nếu truyện chữ) hoặc danh sách link ảnh (nếu truyện tranh)
    created_at DATETIME DEFAULT GETDATE(),
    FOREIGN KEY (story_id) REFERENCES Stories(id) ON DELETE CASCADE
);
GO

-- 7. Tạo bảng Bình luận (Comments)
CREATE TABLE Comments (
    id INT IDENTITY(1,1) PRIMARY KEY,
    user_id INT NOT NULL,
    story_id INT NOT NULL,
    content NVARCHAR(1000) NOT NULL,
    created_at DATETIME DEFAULT GETDATE(),
    FOREIGN KEY (user_id) REFERENCES Users(id) ON DELETE CASCADE,
    FOREIGN KEY (story_id) REFERENCES Stories(id) ON DELETE CASCADE
);
GO

-- 8. Tạo bảng Theo dõi / Yêu thích (Favorites)
CREATE TABLE Favorites (
    user_id INT,
    story_id INT,
    created_at DATETIME DEFAULT GETDATE(),
    PRIMARY KEY (user_id, story_id),
    FOREIGN KEY (user_id) REFERENCES Users(id) ON DELETE CASCADE,
    FOREIGN KEY (story_id) REFERENCES Stories(id) ON DELETE CASCADE
);
GO

-- 9. Tạo bảng Lịch sử đọc (Reading_History)
CREATE TABLE Reading_History (
    user_id INT,
    story_id INT,
    last_chapter_id INT NOT NULL,
    updated_at DATETIME DEFAULT GETDATE(),
    PRIMARY KEY (user_id, story_id),
    FOREIGN KEY (user_id) REFERENCES Users(id), -- Không dùng CASCADE ở đây để tránh đụng độ vòng lặp xóa
    FOREIGN KEY (story_id) REFERENCES Stories(id),
    FOREIGN KEY (last_chapter_id) REFERENCES Chapters(id)
);
GO

